# Copy this file to .env and fill in values. .env is git-ignored.

# Flask session secret. Any random string is fine for local single-user use.
SECRET_KEY=change-me-to-something-random

# Shown on the Dashboard's morning/afternoon/evening greeting, e.g. "Thess".
# Leave blank for a name-less greeting.
DISPLAY_NAME=

# Phase 4 only (optional AI features, off by default even if this is set --
# also requires the toggle in Settings to be switched on).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
