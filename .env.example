# Copy this file to .env and fill in values. .env is git-ignored.

# Flask session secret. Any random string is fine for local single-user use.
SECRET_KEY=change-me-to-something-random

# Shown on the Dashboard's morning/afternoon/evening greeting, e.g. "Thess".
# Leave blank for a name-less greeting.
DISPLAY_NAME=

# Dashboard's internship countdown + "Week N" tracker (both YYYY-MM-DD).
# Leave blank to use the defaults baked into daybook/config.py.
INTERNSHIP_START_DATE=
INTERNSHIP_END_DATE=

# Phase 4 only (optional AI features, off by default even if this is set --
# also requires the toggle in Settings to be switched on).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Dashboard "Coming up" (Outlook calendar) -------------------------
# Where to read your calendar from:
#   auto  - classic Outlook desktop if it's running on this machine
#           (no setup at all), otherwise Microsoft Graph. The default.
#   com   - force Outlook desktop (Windows + classic Outlook only).
#   graph - force Microsoft Graph.
#   off   - hide the card.
OUTLOOK_SOURCE=auto

# Graph path only. Client id of a public-client app registration with the
# delegated Calendars.Read permission; there is deliberately no client
# secret here -- the token is yours, obtained once by `flask
# outlook-login` and refreshed silently after that. Leave blank if you're
# using Outlook desktop.
GRAPH_CLIENT_ID=
# Leave as "organizations" unless you need to pin a specific tenant.
GRAPH_TENANT_ID=organizations

# Graph path only: your mailbox timezone, as a *Windows* timezone name
# (that's what Graph expects, and what Outlook itself shows you).
CALENDAR_TIMEZONE=GMT Standard Time

# How many days the card shows, and how far its arrows page.
CALENDAR_DAYS=3
# How long a fetched calendar is reused before re-reading Outlook.
CALENDAR_CACHE_SECONDS=120
